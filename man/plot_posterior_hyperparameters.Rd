\name{plot_posterior_hyperparameters}
\alias{plot_posterior_hyperparameters}
\title{Posterior hyperparameter plot}
\usage{plot_posterior_hyperparameters(object, main = "Posterior hyperparameters")}
\arguments{
\item{object}{A fitted \code{bottom_up_fit}.}
\item{main}{Plot title.}
}
\value{Hyperparameter posterior summary, invisibly.}
\description{Plots posterior means and 95 percent credible intervals for model hyperparameters.}
