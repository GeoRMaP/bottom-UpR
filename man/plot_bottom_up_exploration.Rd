\name{plot_bottom_up_exploration}
\alias{plot_bottom_up_exploration}
\title{Exploratory population-data plots}
\usage{plot_bottom_up_exploration(data, response, buildings = NULL, covariates = NULL)}
\arguments{
\item{data}{Input data frame.}
\item{response}{Response column name.}
\item{buildings}{Optional building-count column.}
\item{covariates}{Optional covariate names.}
}
\value{Summary information, invisibly.}
\description{Produces compact exploratory plots of population, buildings and PPB structure.}
