\name{bottom_up_warning_catalogue}
\alias{bottom_up_warning_catalogue}
\title{List bottom-UpR warning messages and recommended actions}
\usage{bottom_up_warning_catalogue()}
\value{A data frame with warning category, message, trigger, and suggested action.}
\description{Returns a catalogue of package-level warnings used by the main bottom-UpR modelling workflow. Warnings originating internally from INLA itself are not reproduced.}
