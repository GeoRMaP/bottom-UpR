\name{plot_posterior_fixed}
\alias{plot_posterior_fixed}
\title{Posterior fixed-effect plot}
\usage{plot_posterior_fixed(object, include_intercept = FALSE, main = "Posterior fixed effects")}
\arguments{
\item{object}{A fitted \code{bottom_up_fit}.}
\item{include_intercept}{Include the intercept in the forest plot.}
\item{main}{Plot title.}
}
\value{Fixed-effect posterior summary, invisibly.}
\description{Plots posterior means and 95 percent credible intervals for fixed effects.}
